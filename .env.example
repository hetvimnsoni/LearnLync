# ==============================================================================
# LearnLync Environment Configuration (.env.example)
# Duplicate this file as .env.local and populate with your credentials
# ==============================================================================

# 1. Supabase Authentication & Database
# Find these in your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Nexconn Chat SDK
NEXT_PUBLIC_NEXCONN_APP_KEY=your_nexconn_app_key
NEXCONN_APP_SECRET=your_nexconn_app_secret
