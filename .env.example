
# LearnLync Environment Configuration
# Copy this file to .env.local and add your own credentials.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Nexconn Chat SDK
NEXT_PUBLIC_NEXCONN_APP_KEY=your-nexconn-app-key
NEXCONN_APP_SECRET=your-nexconn-app-secret

# Google Gemini AI (server-side only)
GEMINI_API_KEY=your-gemini-api-key
