# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Nexconn Chat Configuration (for real-time messaging)
NEXT_PUBLIC_NEXCONN_APP_KEY=your-nexconn-app-key
NEXCONN_APP_SECRET=your-nexconn-app-secret

# Google Gemini AI Configuration (for AI-powered learning assistant)
GEMINI_API_KEY=your-gemini-api-key
